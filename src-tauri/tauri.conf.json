{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NewsMapCN",
  "version": "0.1.0",
  "identifier": "com.newsmap.cn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NewsMap CN 设置",
        "width": 860,
        "height": 620,
        "resizable": false,
        "center": true,
        "visible": true
      },
      {
        "label": "screensaver",
        "title": "NewsMap CN",
        "width": 1600,
        "height": 900,
        "fullscreen": true,
        "decorations": false,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      },
      {
        "label": "preview",
        "title": "NewsMap CN 效果预览",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost https: data:",
        "style-src": "'self' 'unsafe-inline' asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/*.img"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "startMenuFolder": "NewsMap CN",
        "installerHooks": "nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
